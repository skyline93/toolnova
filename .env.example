# 复制为仓库根目录的 `.env`，供 `docker compose` 与根目录 `Makefile` 读取。
# 生产机只需：docker-compose.yml + .env（可选）+ 已 docker pull 的镜像 → docker compose up -d

# ---- 镜像名（与 CI/仓库 tag 一致）----
TOOLNOVA_WEB_IMAGE=toolnova-web:latest
TOOLNOVA_MARKDOWN_PDF_IMAGE=toolnova-markdown-pdf:latest

# ---- 仅用于 make tag-registry*（构建完成后打远程 tag；末尾须带 /）----
# REGISTRY_PREFIX=registry.cn-shenzhen.aliyuncs.com/greene/

# 宿主机映射端口
WEB_PORT=3000

# ---- Next → PDF（Compose 内默认已指向服务名 markdown-pdf）----
PDF_SERVICE_URL=http://markdown-pdf:8000
# 若设置，须与 PDF_INTERNAL_API_TOKEN 相同
PDF_SERVICE_SECRET=

# ---- Markdown 导出字号（可选，写入 web 容器运行环境；12–22，默认 14）----
# MARKDOWN_EXPORT_BASE_FONT_PX=14

# ---- PDF 服务 ----
PDF_WEB_CONCURRENCY=2
PDF_INTERNAL_API_TOKEN=

# ---- 仅用于根目录 make build / docker build（写入前端产物，compose up 不读取）----
# NEXT_PUBLIC_SITE_URL=https://example.com
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
