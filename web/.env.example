# Public site URL (no trailing slash) — required in production for metadata, sitemap, JSON-LD
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: Markdown export — base body font size in pixels (12–22) for downloaded HTML and for PDF
# (Next injects CSS into the payload to the PDF service). Server-only; default 14 if unset.
# MARKDOWN_EXPORT_BASE_FONT_PX=14

# Markdown → PDF (Python Playwright service). Server-side only; not exposed to the browser.
# Example local: http://127.0.0.1:8000
# PDF_SERVICE_URL=http://127.0.0.1:8000
# Optional shared secret; must match Python service INTERNAL_API_TOKEN when set
# PDF_SERVICE_SECRET=

# Optional: Google Analytics 4 — loads only after user clicks "Accept all" on the cookie banner
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Google AdSense — both required for the footer slot to request ads (after site approval)
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
# NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=1234567890
